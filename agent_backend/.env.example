# Claude (key stays on the server; the app never sees it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Auth: firebase (production) verifies the app's Firebase ID token; dev trusts X-Dev-User from localhost only
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=contacte-b2228

# Encrypts social-media access tokens at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/agent.sqlite3

# Shared secret for the cron job that calls POST /scheduler/run-due
CRON_SECRET=

META_GRAPH_VERSION=v21.0
LINKEDIN_VERSION=202410

CORS_ORIGINS=
